# Copy this file to `.env` or `.env.local` and fill in local credentials.
# `.env.local` is loaded after `.env`; exported shell variables still take priority.

# Scholarly metadata APIs
OPENALEX_EMAIL=
OPENALEX_API_KEY=
# Optional comma/space separated pool. Used round-robin by corpus/Fig1 builders.
OPENALEX_API_KEYS=
ASPR_GEAR_OPENALEX_PDF_ENABLED=false
ASPR_GEAR_OPENALEX_PDF_MAX_DOWNLOADS=3
ASPR_GEAR_OPENALEX_PDF_MAX_BYTES=25000000
ASPR_GEAR_OPENALEX_PDF_MAX_PAGES=100
ASPR_GEAR_OPENALEX_PDF_MAX_CHARACTERS=30000
S2_API_KEY=

# PubMed / NCBI E-utilities
NCBI_EMAIL=
NCBI_API_KEY=

# HuggingFace Hub
HF_TOKEN=

# Local model/server defaults used by aspr.open_scholar
ASPR_LARGE_MODEL_PORT=38011
ASPR_SMALL_MODEL_PORT=38014
ASPR_API_PORT=38015
ASPR_TOP_N=10
ASPR_MAX_TOKENS=3000

# ASPR-GEAR model backend. Default is an isolated, ephemeral Codex CLI session.
# Set ASPR_GEAR_MODEL_BACKEND=openai_compatible to use a stateless
# OpenAI-compatible API (for example DeepSeek) instead.
ASPR_GEAR_MODEL_BACKEND=codex_cli
ASPR_GEAR_CODEX_EXECUTABLE=codex
ASPR_GEAR_CODEX_MODEL=gpt-5.6-terra
ASPR_GEAR_CODEX_REASONING_EFFORT=high
ASPR_GEAR_CODEX_TIMEOUT_SECONDS=1800
# API mode configuration. Put the actual secret only in the named key variable,
# preferably in an ignored .env.local or in the process environment.
ASPR_GEAR_API_BASE_URL=
ASPR_GEAR_API_MODEL=
ASPR_GEAR_API_KEY_ENV=DEEPSEEK_API_KEY
ASPR_GEAR_API_TIMEOUT_SECONDS=1800
DEEPSEEK_API_KEY=
ASPR_GEAR_ALLOW_EXTERNAL_RETRIEVAL=true
ASPR_GEAR_CACHE_DIR=data/gear_cache
ASPR_GEAR_OUTPUT_ROOT=outputs/gear/runs
ASPR_GEAR_CALIBRATION_REGISTRY=configs/gear/calibration_registry.json
ASPR_GEAR_CALIBRATION_RELEASE=prepublication_graph_v3:d5_fulltext16
ASPR_GEAR_RETRIEVAL_NORMAL_MAX=2
ASPR_GEAR_RETRIEVAL_CONTRASTIVE_MAX=1
ASPR_GEAR_RETRIEVAL_CITATION_MAX=1
ASPR_GEAR_RETRIEVAL_EVIDENCE_MAX=12

# GPT used only to construct/score the peer-review alignment benchmark.
# This is separate from ASPR-Qwen and may point to any OpenAI-compatible endpoint.
ASPR_ALIGNMENT_GPT_BASE_URL=https://api.openai.com/v1
ASPR_ALIGNMENT_GPT_MODEL=gpt-5.2
ASPR_ALIGNMENT_GPT_API_KEY=
ASPR_ALIGNMENT_GPT_MAX_TOKENS=12000
ASPR_ALIGNMENT_GPT_TIMEOUT=600

# Plot/cache behavior
MPLCONFIGDIR=/tmp/aspr_matplotlib_cache
# Optional OpenReview API-v2 authentication. Token takes precedence.
OPENREVIEW_TOKEN=
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
