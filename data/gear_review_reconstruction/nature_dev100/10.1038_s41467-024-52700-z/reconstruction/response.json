    "summary": {
      "evidence_keys": [
        "P:S-6f54342df392b848dacf",
        "P:S-838bce1449c46ea0540e",
        "P:S-5522d2cc621411744ca2"
      ],
      "schema_version": "aspr_gear",
      "text": "This multicenter single-arm phase II study evaluates apatinib plus oxaliplatin-raltitrexed HAIC after first-line systemic therapy for HCC with extrahepatic metastasis. It reports RECIST v1.1 ORR of 53.8%, median PFS of 6.2 months, median OS of 11.3 months, and treatment-related adverse events in 39 patients. The final paper clarifies several reporting details, but its uncontrolled design and retained cross-trial interpretation leave the incremental contribution of HAIC unresolved; the lesion-specific control-period analysis and imaging adjudication remain insufficiently specified."
    },
    "weaknesses": [
      {
        "aspect": "results_conclusion",
        "evidence_keys": [
          "P:S-5522d2cc621411744ca2",
          "P:S-6e9a2dfc6ed07dcac7d9"
        ],
        "external_verification_required": false,
        "point_id": "W-INTERPRET-01",
        "schema_version": "aspr_gear",
        "severity": "major",
        "suggested_action": "Restrict cross-trial comparisons to descriptive context and remove causal or efficacy-superiority inferences about HAIC plus apatinib.",
        "text": "The discussion retains an overinterpretation of non-head-to-head comparisons, presenting better outcomes versus apatinib monotherapy and potential HAIC-apatinib synergy despite the absence of a concurrent control."
      }
    ]
  },
