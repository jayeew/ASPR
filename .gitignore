# 忽略 Python 字节码缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_tmp/
.pytest_cache/
.mypy_cache/
.ruff_cache/

*.txt
!/requirements.txt
!requirements-figures.txt
!/figures/fig*/code/**/requirements.txt
*.log
.env
.env.local
.env.*.local

.superpowers/

# Generated corpus and experiment artifacts are large local data products.
data/knowledge_corpus/
outputs/
!/outputs/
/outputs/*
!outputs/README.md
!outputs/fig1-11_final/
outputs/fig1-11_final/*

# Local assets in the migrated layout. Git carries documentation and placeholders.
/figures/fig*/data/*
!/figures/fig*/data/.gitkeep
!/figures/fig*/data/*/
/figures/fig*/data/*/*
!/figures/fig*/data/*/.gitkeep
!/figures/fig3/data/five_dimensions/README.md
!/figures/fig8/data/corpus/README.md
/figures/fig*/final/*
!/figures/fig*/final/.gitkeep
/figures/fig*/assets/*
!/figures/fig*/assets/.gitkeep
/figures/shared/reviewer_coding/*
!/figures/shared/reviewer_coding/README.md
/manuscript/nature_innovation/*
!/manuscript/nature_innovation/README.md
/docs/hdd_large_files.json
/docs/hdd_migration.json

data/gear_cache/
data/cache/
data/calibration/releases/
data/calibration/runtime_replay/
# Large, reproducible frozen-release result matrices remain local artifacts.
innovation_impact_feature_selection/evidence_derived/frozen_releases/**/*.parquet
outputs/gear/runs/
data/gear_peer_review_benchmark_v1/
outputs/gear/review_alignment/
# Claim-graph indexes, local model weights, and DOI-audit databases are
