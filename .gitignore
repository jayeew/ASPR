# 忽略 Python 字节码缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_tmp/

*.txt
!requirements-figures.txt
*.log
.env
.env.local
.env.*.local

.superpowers/

# Generated corpus and experiment artifacts are large local data products.
data/knowledge_corpus/
outputs/
data/gear_cache/
data/cache/
data/calibration/releases/
data/calibration/runtime_replay/
# Large, reproducible frozen-release result matrices remain local artifacts.
innovation_impact_feature_selection/evidence_derived/frozen_releases/**/*.parquet
outputs/gear/runs/
data/gear_peer_review_benchmark_v1/
outputs/gear/review_alignment/
# Claim-graph indexes, local model weights, and DOI-audit databases are
# reproducible local artifacts; source code and configuration stay tracked.
data/claim_graph/
data/doi_coverage_audit/
data/models/

# Large local data files (multi-MB JSON / parquet) are regenerable, not source.
kg_validator/output/
data/papers.json
data/total_related_papers.json
*.parquet

# Local packaging artifact and its generator script.
ASPR_code_dev10_runs.zip
tmp/make_zip.py
